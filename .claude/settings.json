{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "draft|post|escribir|redactar|borrador",
        "hooks": [
          {
            "type": "command",
            "command": "echo '[linkedin-posts] Reminder: log this post to memory/posts/ after publishing (see supermemory-skill.md)' >&2"
          }
        ]
      }
    ]
  }
}
